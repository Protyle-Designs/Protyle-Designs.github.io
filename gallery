<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gallery | Protyle Designs</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

/* NAV */
.nav{
    text-align:center;
    padding:20px;
    background:#fff;
    border-bottom:1px solid #e2e8f0;
}

.nav a{
    margin:0 12px;
    text-decoration:none;
    color:#2563eb;
    font-weight:600;
}

/* BASE */
body{
    margin:0;
    font-family:Inter;
    background:#f8fafc;
}

/* GALLERY */
.gallery{
    max-width:1200px;
    margin:auto;
    padding:60px 30px;
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:20px;
}

.gallery img{
    width:100%;
    aspect-ratio:4/3;
    object-fit:cover;
    border-radius:12px;
}

@media(max-width:768px){
    .gallery{
        grid-template-columns:repeat(2, 1fr);
    }
}
</style>
</head>

<body>

<nav class="nav">
    <a href="index.html">Home</a>
    <a href="gallery.html">Gallery</a>
    <a href="services.html">Services</a>
    <a href="contact.html">Contact</a>
</nav>

<div class="gallery">
    <img src="img1.png">
    <img src="img2.png">
    <img src="img3.png">
    <img src="img4.png">
    <img src="img5.png">
    <img src="img6.png">
    <img src="img7.png">
    <img src="img8.png">
</div>

</body>
</html>
